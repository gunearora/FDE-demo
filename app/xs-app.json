{
  "welcomeFile": "/webapp/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 30,
  "logout": {
    "logoutEndpoint": "/do/logout"
  },
  "routes": [
    {
      "source": "^/delivery/(.*)$",
      "target": "/delivery/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/webapp/(.*)$",
      "target": "/webapp/$1",
      "localDir": "webapp",
      "authenticationType": "xsuaa",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "localDir": "webapp",
      "authenticationType": "xsuaa"
    }
  ]
}
